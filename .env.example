# Repo-root .env — read automatically by `docker compose` from the working
# directory. Copy to `.env` (gitignored) and fill in real values.
#
# This file is the inventory of every host-level var the compose stack
# reads. Three flavors of var live here, distinguished by how compose treats
# them:
#   1. Optional with a sensible default in docker-compose.yml — base + dev
#      shapes work fine if you don't set them.
#   2. REQUIRED IN PROD (marked below) — docker-compose.prod.yml uses the
#      `${VAR:?msg}` substitution form. If the var is unset (or empty for
#      most), `docker compose -f ... -f docker-compose.prod.yml up` fails
#      fast with the listed message. That's intentional: a missing
#      POSTGRES_PASSWORD must not silently fall back to the dev default.
#   3. RESEND_API_KEY uses `${VAR?msg}` (no colon) — it must be DEFINED
#      (even as empty) but empty is accepted, so a localhost smoke test of
#      the prod shape can still use the in-app stdout fallback for
#      magic-link delivery.
#
# This file does NOT replace backend/.env. The four-process non-Docker dev
# layout (Redis + uvicorn + RQ worker + Vite) still reads backend/.env via
# pydantic-settings — keep that file working alongside this one.
#
# DATABASE_URL and REDIS_URL are deliberately NOT listed here: inside
# compose they must point at the sibling service hostnames (`postgres`,
# `redis`), and overriding them from the host would break the wiring. The
# prod override file rebuilds DATABASE_URL internally using
# POSTGRES_PASSWORD below.


# === Required in prod shape ===
# `docker compose -f docker-compose.yml -f docker-compose.prod.yml up` fails
# if any of these is unset/empty (RESEND_API_KEY: unset only).

# Postgres password. The prod override threads this into both the postgres
# service's POSTGRES_PASSWORD AND the api/worker DATABASE_URL. Use a long
# random string in real prod (e.g. `openssl rand -base64 32`).
POSTGRES_PASSWORD=

# Where magic-link emails / stdout-printed links point. Must be the URL
# users hit in their browser — the public-facing host for the Nginx
# (frontend) container. For a localhost smoke test of the prod shape:
# http://localhost. For a real VPS: https://audithealth.example.com.
FRONTEND_BASE_URL=

# Resend transactional sender. MUST be a verified sender on your Resend
# account in real prod — `onboarding@resend.dev` is Resend's shared
# sandbox and only delivers to the account owner's verified email. The
# `Name <addr@domain>` form is the wire format Resend expects.
FROM_EMAIL=

# Resend API key. https://resend.com/api-keys. Empty is allowed by the
# compose-level guard (the in-app fallback prints magic links to
# `docker compose logs api` so a localhost prod-shape smoke test works
# without a real key) but a real prod environment must set it — otherwise
# sign-in emails never leave the box.
RESEND_API_KEY=


# === Optional — sensible defaults baked into docker-compose.yml ===

# Application environment label (free-form tag, used as `APP_ENV` inside
# the containers). Override to `production` when this .env feeds the prod
# compose shape.
APP_ENV=development

# Set true in prod (HTTPS). The prod override defaults to `true`; override
# back to `false` for a localhost smoke test where there's no HTTPS — a
# `Secure` cookie won't stick on a plain http:// localhost response and
# sign-in will silently fail.
SESSION_COOKIE_SECURE=false

# Auth — magic-link / session TTLs and cookie name.
MAGIC_LINK_TTL_MINUTES=15
SESSION_TTL_DAYS=30
SESSION_COOKIE_NAME=session

# Selenium / audit worker knobs (process-local — the worker is the actual
# Chromium consumer). Default cap = 1; see project_notes.md "Concurrency
# cap" before bumping.
AUDIT_MAX_CONCURRENT_DRIVERS=1
AUDIT_PAGE_TIMEOUT=30
AUDIT_SCRIPT_TIMEOUT=20
