# ---- SEO Health — production environment template ----
# Copy to `.env.prod` ON THE SERVER and fill in the blanks (chmod 600 .env.prod).
# Never commit the real .env.prod — only this .example file is safe to commit.
#
# Deploy command (run from the project dir on the server):
#   docker compose --env-file .env.prod \
#     -f docker-compose.yml -f docker-compose.prod.yml -f docker-compose.caddy.yml \
#     up -d --build
#
# Items marked REQUIRED have no safe default — the prod compose fails loudly if
# they're unset.

# --- REQUIRED ---
# Strong random Postgres password. Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=
# Public site URL (https — Caddy terminates TLS). Drives magic-link + push links.
FRONTEND_BASE_URL=https://seohealth.in
APP_ENV=production
# HTTPS is in front, so the session cookie must be Secure.
SESSION_COOKIE_SECURE=true

# --- Email (Resend) — set once you've created the account + verified a sender ---
# Empty is accepted (logins just won't actually send). Create at resend.com,
# verify a sending domain/subdomain, then paste the key here.
RESEND_API_KEY=
FROM_EMAIL=SEO Health <hello@seohealth.in>

# --- Web Push (VAPID) — set to enable push notifications in prod ---
# Generate a FRESH prod keypair:
#   docker compose run --rm api python scripts/gen_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@seohealth.in

# --- Founder admin panel (/admin) ---
ADMIN_EMAILS=adwaithjk98@gmail.com

# --- Error monitoring (Sentry) — optional; empty = off ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Razorpay — leave empty for mock checkout until KYC + live keys exist ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PAID_PLAN_ID=
RAZORPAY_MAX_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
PAID_PLAN_PRICE_LABEL=₹549 / month
MAX_PLAN_PRICE_LABEL=₹2,500 / month

# --- Competitor-insights LLM phrasing — optional (deterministic fallback) ---
ANTHROPIC_API_KEY=

# --- PageSpeed Insights — Performance / Site-Speed pillar (Core Web Vitals) ---
# HTTP API (no headless browser). Empty = anonymous low-quota path; set a real
# key for the higher per-day quota. STRATEGY: mobile (default) or desktop.
PAGESPEED_API_KEY=
PAGESPEED_STRATEGY=mobile
