# Database — switch DATABASE_URL when you outgrow SQLite (concurrent jobs, hosted infra).
# SQLite (dev default — single-file, zero setup):
DATABASE_URL=sqlite:///./audithealth.db
# Postgres (use this once a local Postgres is running, or in production):
# DATABASE_URL=postgresql+psycopg://audithealth:audithealth@localhost:5432/audithealth
APP_ENV=development

# Resend — transactional email (magic-link delivery).
# Get an API key at https://resend.com/api-keys.
# Leave RESEND_API_KEY empty in dev to fall back to stdout-printed magic links.
# FROM_EMAIL must be a verified sender on your Resend account in production;
# the default `onboarding@resend.dev` works only for the account owner's email.
RESEND_API_KEY=
FROM_EMAIL=Local SEO Health Monitor <onboarding@resend.dev>
