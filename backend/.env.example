# Database — switch DATABASE_URL when you outgrow SQLite (concurrent jobs, hosted infra).
# SQLite (dev default — single-file, zero setup):
DATABASE_URL=sqlite:///./audithealth.db
# Postgres (use this once a local Postgres is running, or in production):
# DATABASE_URL=postgresql+psycopg://audithealth:audithealth@localhost:5432/audithealth
APP_ENV=development

# Resend — transactional email (magic-link delivery).
# Get an API key at https://resend.com/api-keys.
# Leave RESEND_API_KEY empty in dev to fall back to stdout-printed magic links.
# FROM_EMAIL must be a verified sender on your Resend account in production;
# the default `onboarding@resend.dev` works only for the account owner's email.
RESEND_API_KEY=
FROM_EMAIL=Local SEO Health Monitor <onboarding@resend.dev>

# Redis — used by RQ (job queue) and the cross-process audit-event bus. Points at local Redis in dev.
REDIS_URL=redis://localhost:6379/0

# Razorpay — subscription billing. PHASE 3 RUNS IN TEST MODE ONLY.
# Leave RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET empty in dev to use the
# in-app mock-checkout flow (no external HTTP, no cost). When you supply
# real test-mode credentials, you must also set RAZORPAY_PAID_PLAN_ID
# (the plan id from the Razorpay dashboard for the Paid tier).
# RAZORPAY_WEBHOOK_SECRET, when set, makes /api/subscriptions/webhook
# verify the X-Razorpay-Signature HMAC; leave empty in dev to allow
# unsigned curl requests for local simulation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PAID_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
PAID_PLAN_PRICE_LABEL=₹399 / month

# Places API (New) — Google Cloud key for the Maps pillar + competitor refresh
# (Place Details) + discovery (Text Search); replaces the Selenium maps.py
# scraper. Create in GCP console → APIs & Services → Credentials, restrict to
# "Places API (New)". Leave empty until the maps → Places migration ships.
PLACES_API_KEY=

# Instagram Graph API — Model A (business_discovery). One server-side token
# reads PUBLIC stats for any IG Business/Creator handle; powers both the user's
# own IG audit section and competitor IG tracking, with the OG-tag scraper as
# automatic fallback when unset/unreachable.
#
# VERIFIED 2026-06-29: business_discovery needs a USER token (not a Page token)
# with scopes: instagram_basic, instagram_manage_insights, pages_read_engagement,
# ads_read (ads_read because the Page is owned by a Business portfolio). All four
# are Standard Access ("Ready for testing") — no App Review. For a non-expiring
# token use a Business Manager System User token; mint/inspect with:
#   META_APP_SECRET=xxxx python scripts/ig_token.py <token>
# IG_GRAPH_USER_ID defaults to the @seo.health IG Business id.
IG_GRAPH_ENABLED=false
IG_GRAPH_ACCESS_TOKEN=
IG_GRAPH_USER_ID=17841413032640533
# OG-tag fallback scraper (anonymous instagram.com GET). OFF by default so dev
# behaves like a server — from a datacenter IP that GET gets rate-limited /
# CAPTCHA-walled (the problem the Graph migration avoids). When Graph can't read
# a handle, the IG section shows a clean "not a Business/Creator account" state.
# Flip on ONLY for local debugging on a residential IP.
IG_SCRAPER_FALLBACK_ENABLED=false
# META_APP_SECRET is server-only (also used for appsecret_proof) — never commit
# a real value. META_APP_ID is public; it defaults to the SEO Health app id.
META_APP_ID=1378304534203823
META_APP_SECRET=
