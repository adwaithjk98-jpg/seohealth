# Local virtualenv — image installs deps fresh against requirements.txt.
.venv/
venv/

# Python build artefacts.
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
tests/__pycache__/

# Env files — env is passed in at run-time via compose, never baked in.
.env
.env.*

# Local SQLite dev DB (the prod target is Postgres).
*.db
*.sqlite
*.sqlite*
seohealth.db

# VCS / editor cruft.
.git/
.gitignore
.idea/
.vscode/
.DS_Store

# Docker-related files don't belong inside the build context.
Dockerfile
.dockerignore
